# Environment Variables

# Mapbox Access Token
# Get your token at: https://account.mapbox.com/access-tokens/
# This token must be prefixed with NEXT_PUBLIC_ to be accessible in client components
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Backend API URL
# Update this to point to your backend API endpoint
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/api/query
